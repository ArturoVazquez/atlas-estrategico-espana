      "properties": {
        "slug": "plataforma-continental-canarias",
        "nombre": "Límite exterior de la plataforma continental al oeste de Canarias",
        "categoria": "limite_declarado",
        "descripcion": "Los 448 puntos fijos con los que España trazó, ante la Comisión de Límites de la Plataforma Continental, el límite exterior de su plataforma más allá de las 200 millas al oeste de las Islas Canarias. Es una LÍNEA, no una zona: el documento deposita el borde exterior, no el perímetro completo.",
        "estado_registro": "vigente",
        "verif": "confirmado",
        "geo_precision": "exacta",
        "geo_fuente": "los 448 puntos fijos del Anexo 1 del resumen ejecutivo, en WGS84, redondeados a 5 decimales (§4)",
        "geo_fuente__v": "confirmado",
        "geo_fuente__f": "f1",
        "fecha_alta": "2026-08-06",
        "fecha_verificacion": "2026-08-06",
