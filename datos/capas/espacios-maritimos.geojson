        "estado_juridico__v": "confirmado",
        "estado_juridico__f": "f1",
        "partes": [
          "España",
          "Marruecos",
          "Portugal"
        ],
        "instrumento": "Presentación parcial ante la CLCS, 17 de diciembre de 2014 (CLCS.77.2014.LOS)",
        "claves": [
          {
            "k": "Cómo se trazó",
            "v": "Líneas rectas de no más de 60 millas uniendo 448 puntos fijos, a partir de 29 puntos de pie de talud determinados con sonda multihaz. Las líneas de base son las del Real Decreto 2510/1977.",
            "verif": "confirmado",
            "fuente": "f1"
          },
          {
            "k": "Quién objetó",
            "v": "Marruecos, el 10 de marzo de 2015, y Portugal, el 1 de abril de 2015. La objeción marroquí no discute el trazado técnico: sostiene que recae sobre espacios aún no delimitados.",
            "verif": "confirmado",
            "fuente": "f2"
          },
          {
            "k": "Qué falta",
            "v": "La Comisión no ha emitido recomendaciones sobre esta presentación. Un límite depositado no es un límite reconocido.",
            "verif": "confirmado",
            "fuente": "f1"
          }
        ],
        "fuentes": [
